    <gui>
      <camera name="user_camera">
        <pose>-2 -2 4 0 0.6 0.8</pose>
      </camera>
    </gui>


    <model name="plant_1">
      <static>true</static>
      <pose>0.557 0.616 0 0 0 0</pose>
